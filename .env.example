# ─── AI Provider (leave blank to use realistic mock mode) ───────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Alternatively use Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Observability / MCP (leave blank to use simulated Coralogix mock) ───────
CORALOGIX_API_KEY=
CORALOGIX_ENDPOINT=https://api.coralogix.com/api/v1/logs
CORALOGIX_REGION=EU

# Transaction pooler (port 6543) — runtime / serverless (append ?pgbouncer=true for Prisma)
DATABASE_URL=postgresql://postgres.jftgzriskgretpfhlwpy:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler (port 5432) — login cookies / migrations
DIRECT_URL=postgresql://postgres.jftgzriskgretpfhlwpy:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ─── Authentication (GitHub OAuth) ───────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Authentication (Google OAuth) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Generated Test Runtime ──────────────────────────────────────────────────
BASE_URL=http://localhost:3000
TEST_EMAIL=test@example.com
TEST_PASSWORD=testpassword

# ─── GitHub Actions cloud runner (portfolio demo — set on Vercel for all visitors) ─
GITHUB_ACTIONS_REPO=ShakedGarame/QA-Genius
# GITHUB_ACTIONS_PAT=ghp_…   # Fine-grained or classic PAT with "repo" scope — add in Vercel dashboard, NOT in git
# USE_GITHUB_ACTIONS_RUNNER=1   # force GitHub Actions on localhost (also works when PAT is sent from Settings UI)

# ─── Frontend (Vite) ───────────────────────────────────────────────────────
# VITE_USE_GITHUB_ACTIONS=true   # optional: force cloud runner on localhost even without PAT in localStorage

# ─── Vercel production overrides (set in Vercel dashboard) ───────────────────
# BACKEND_URL=https://qa-genius-app.vercel.app
# FRONTEND_URL=https://qa-genius-app.vercel.app
# NODE_ENV=production
