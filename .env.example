# ─── AI Provider (leave blank to use realistic mock mode) ───────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Alternatively use Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Observability / MCP (leave blank to use simulated Coralogix mock) ───────
CORALOGIX_API_KEY=
CORALOGIX_ENDPOINT=https://api.coralogix.com/api/v1/logs
CORALOGIX_REGION=EU

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# From Supabase: Project Settings → Database → Connection string (URI)
# Use the direct connection (port 5432) for local dev and migrations.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ─── Authentication (GitHub OAuth) ───────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Authentication (Google OAuth) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Generated Test Runtime ──────────────────────────────────────────────────
BASE_URL=http://localhost:3000
TEST_EMAIL=test@example.com
TEST_PASSWORD=testpassword

# ─── Vercel production overrides (set in Vercel dashboard) ───────────────────
# BACKEND_URL=https://your-app.vercel.app
# FRONTEND_URL=https://your-app.vercel.app
# NODE_ENV=production
