generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(uuid())
  githubId   String?  @unique @map("github_id")
  googleId   String?  @unique @map("google_id")
  email      String?
  name       String
  avatarUrl  String?  @map("avatar_url")
  createdAt  DateTime @default(now()) @map("created_at")
  lastLogin  DateTime @default(now()) @map("last_login")

  settings    UserSettings?
  features    Feature[]
  logAnalyses LogAnalysis[]
  testRuns    TestRun[]

  @@map("users")
}

model UserSettings {
  userId            String  @id @map("user_id")
  openaiApiKey      String? @map("openai_api_key")
  anthropicApiKey   String? @map("anthropic_api_key")
  coralogixApiKey   String? @map("coralogix_api_key")
  coralogixTeamName String? @map("coralogix_team_name")
  coralogixRegion   String? @default("EU") @map("coralogix_region")
  testsOutputDir    String? @map("tests_output_dir")
  // Ticketing integrations
  githubIssuesRepo  String? @map("github_issues_repo")
  jiraDomain        String? @map("jira_domain")
  jiraEmail         String? @map("jira_email")
  jiraApiToken      String? @map("jira_api_token")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Feature {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  slug        String
  featureName String   @map("feature_name")
  inputType   String   @map("input_type")
  description String?
  prdText     String?  @map("prd_text")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tests GeneratedTest[]

  @@unique([userId, slug])
  @@map("features")
}

model GeneratedTest {
  id        String   @id @default(uuid())
  featureId String   @map("feature_id")
  fileName  String   @map("file_name")
  code      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  feature  Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)
  testRuns TestRun[]

  @@unique([featureId, fileName])
  @@map("generated_tests")
}

model TestRun {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  testFileId   String?  @map("test_file_id")
  featureName  String   @map("feature_name")
  testFileName String?  @map("test_file_name")
  relativePath String?  @map("relative_path")
  status       String   @default("RUNNING")
  durationMs   Int      @default(0) @map("duration_ms")
  gitHubRunId  String?  @map("github_run_id")
  runner       String?  @default("local")
  htmlUrl      String?  @map("html_url")
  artifactMeta Json?    @map("artifact_meta")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  testFile GeneratedTest? @relation(fields: [testFileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("test_runs")
}

model LogAnalysis {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  source       String
  rawLogs      String   @map("raw_logs") @db.Text
  rootCause    String   @map("root_cause") @db.Text
  explanation  String   @db.Text
  suggestedFix String   @map("suggested_fix") @db.Text
  severity     String
  category     String
  isMock       Boolean  @default(false) @map("is_mock")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("log_analyses")
}

/// Owned by connect-pg-simple (the express-session store in app.ts), not by
/// application code. @@ignore keeps it out of the generated Prisma Client
/// while still declaring it to Prisma Migrate/db push, so schema syncs
/// recognize it as expected and stop trying to drop it.
model Session {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
  @@ignore
}
